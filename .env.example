APP_ENV=production
HOST=0.0.0.0
PORT=8080
DB_PATH=/app/data/digital_goods.db

# 生产环境没有 Mock fallback：不配置就明确显示“未配置”并拒绝 AI 分析。
SENSENOVA_API_TOKEN=
SENSENOVA_MODEL=
SENSENOVA_BASE_URL=https://api.sensenova.cn/v1/llm/chat-completions
SENSENOVA_INPUT_PRICE_PER_MILLION=1.5
SENSENOVA_OUTPUT_PRICE_PER_MILLION=4.5
DAILY_AI_BUDGET_CNY=5
MAX_AI_ITEMS_PER_BATCH=20
MIN_EVIDENCE_FOR_ANALYSIS=1
MIN_SCORE_FOR_PRODUCT=70
HIGH_RISK_THRESHOLD=80

# GitHub 官方 API：不配置也可读公开数据，但匿名限额更低。
GITHUB_TOKEN=

# 可选 RSSHub。自建 Docker 服务时填 http://rsshub:1200；不用就留空。
RSSHUB_BASE_URL=

# Docker 中若要复用 Windows 主机上的 Agent-Reach / Chrome 登录态：
# 1) 主机运行 scripts/agent_reach_bridge.py
# 2) Docker 中填 http://host.docker.internal:8765
AGENT_REACH_BRIDGE_URL=
AGENT_REACH_BRIDGE_TOKEN=

# 真实需求聚类与趋势。聚类本地执行，不产生 AI 费用。
CLUSTER_WINDOW_DAYS=60
TREND_WINDOW_DAYS=30
CLUSTER_SIMILARITY_THRESHOLD=0.34
CLUSTER_MAX_EVIDENCE=1500

# 低人工模式：定时真实采集 + 聚类，绝不会自动调用 SenseNova。
AUTO_COLLECT_ENABLED=false
AUTO_COLLECT_INTERVAL_MINUTES=360

# V1.1 Hardening: 采集限流/重试/退避；全部为真实网络调用控制，不会生成数据。
COLLECTOR_RETRIES=2
COLLECTOR_BACKOFF_BASE_SECONDS=2
COLLECTOR_FAILURE_BACKOFF_MINUTES=15
COLLECTOR_FAILURE_BACKOFF_MAX_MINUTES=360
SOURCE_STALE_AFTER_HOURS=24

# trend 佐证只与 demand 需求簇做相似匹配，不进入需求计数。
TREND_SUPPORT_SIMILARITY_THRESHOLD=0.42
TREND_MIN_CONFIDENCE_FOR_TRUSTED_RANK=35

# Qiniu MaaS (primary LLM)
QINIU_API_TOKEN=
QINIU_BASE_URL=https://api.qnaigc.com/v1/chat/completions
QINIU_MODEL=qwen/qwen3.5-plus
