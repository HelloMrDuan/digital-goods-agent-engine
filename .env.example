APP_ENV=production
HOST=0.0.0.0
PORT=8080
DB_PATH=/app/data/digital_goods.db

# 生产环境没有 Mock fallback：不配置就明确显示“未配置”并拒绝 AI 分析。
SENSENOVA_API_TOKEN=
SENSENOVA_MODEL=
SENSENOVA_BASE_URL=https://api.sensenova.cn/v1/llm/chat-completions
SENSENOVA_INPUT_PRICE_PER_MILLION=1.5
SENSENOVA_OUTPUT_PRICE_PER_MILLION=4.5
DAILY_AI_BUDGET_CNY=5
# 未知/无法定价模型每次调用按该金额预占预算，避免“估算为0”绕过并发预算保护。
AI_UNKNOWN_CALL_RESERVE_CNY=0.10

# 远程 POST/PUT/PATCH/DELETE /api/* 必须配置 Token；未配置时仅允许 loopback 写操作。
# Docker 端口映射访问也建议显式配置，并在网页“系统状态”中录入同一 Token。
API_AUTH_TOKEN=
MAX_AI_ITEMS_PER_BATCH=20
MIN_EVIDENCE_FOR_ANALYSIS=1
MIN_SCORE_FOR_PRODUCT=70
HIGH_RISK_THRESHOLD=80

# V1.2：商业验证用于商品生成等后续动作；Agent 商机分析允许把失败候选判成 WATCH/DROP，
# 避免纯关键词 Gate 在 AI 理解前直接丢掉可能有价值的真实证据。
COMMERCIAL_VALIDATION_MIN_SIGNALS=2
COMMERCIAL_VALIDATION_MIN_AUTHORS=2
COMMERCIAL_VALIDATION_MIN_QUALITY=55
COMMERCIAL_VALIDATION_MIN_TIMESTAMP_COVERAGE=50
COMMERCIAL_VALIDATION_MIN_SCORE=65

# V1.2 Opportunity Agent Engine：Evidence digest 只构建一次，降低六 Agent 重复 token。
# 商机级可以并发，但 Qiniu 客户端会统一按 RPM 节流，不会让多个六-Agent 流程同时打爆上游。
AGENT_EVIDENCE_LIMIT=80
AGENT_DIGEST_SNIPPETS=14
AGENT_SNIPPET_CHARS=420
AGENT_MAX_NEW_TOKENS=800
AGENT_REBUILD_CONCURRENCY=3
AGENT_BUILD_SCORE=75
AGENT_BUILD_MARKET_SCORE=65
AGENT_WATCH_SCORE=50

# GitHub 官方 API：不配置也可读公开数据，但匿名限额更低。
GITHUB_TOKEN=

# 可选 RSSHub。自建 Docker 服务时填 http://rsshub:1200；不用就留空。
RSSHUB_BASE_URL=

# Docker 中若要复用 Windows 主机上的 Agent-Reach / Chrome 登录态：
# 1) 主机运行 scripts/agent_reach_bridge.py
# 2) Docker 中填 http://host.docker.internal:8765
AGENT_REACH_BRIDGE_URL=
AGENT_REACH_BRIDGE_TOKEN=

# 真实需求聚类与趋势。聚类本地执行，不产生 AI 费用。
CLUSTER_WINDOW_DAYS=60
TREND_WINDOW_DAYS=30
CLUSTER_SIMILARITY_THRESHOLD=0.34
CLUSTER_MAX_EVIDENCE=1500

# 低人工模式：定时真实采集 + 聚类 + Market Intel，绝不会自动调用付费 AI。
# 默认开启：启动后自动同步推荐源，并周期采集真实需求、趋势、Marketplace 热度/销量情报。
AUTO_COLLECT_ENABLED=true
AUTO_COLLECT_INTERVAL_MINUTES=180

# Market Intelligence：热度与销量分开记账；没有真实销量字段时 sales_score 保持为空。
MARKET_INTEL_MATCH_THRESHOLD=0.12
MARKET_INTEL_HIGH_HEAT_SCORE=65
MARKET_INTEL_HIGH_SALES_SCORE=60
# Etsy 只把公开店铺页明确显示的 sales 总数记为 sales_scope=shop，不冒充单商品销量。
ETSY_ENRICH_SHOP_SALES=true
ETSY_SHOP_ENRICH_LIMIT=8

# V1.1 Hardening: 采集限流/重试/退避；全部为真实网络调用控制，不会生成数据。
COLLECTOR_RETRIES=2
COLLECTOR_BACKOFF_BASE_SECONDS=2
COLLECTOR_FAILURE_BACKOFF_MINUTES=15
COLLECTOR_FAILURE_BACKOFF_MAX_MINUTES=360
SOURCE_STALE_AFTER_HOURS=24

# trend 佐证只与 demand 需求簇做相似匹配，不进入需求计数。
TREND_SUPPORT_SIMILARITY_THRESHOLD=0.42
TREND_MIN_CONFIDENCE_FOR_TRUSTED_RANK=35

# Qiniu MaaS (primary LLM)
QINIU_API_TOKEN=
QINIU_BASE_URL=https://api.qnaigc.com/v1
QINIU_MODEL=qwen/qwen3.5-plus
# 0 表示：已知模型使用代码内置的七牛公开刊例价做“估算”；未知模型保持未定价。
# 如你的账户存在专属折扣/订阅价，请在这里显式覆盖（单位：元 / 1M tokens）。
QINIU_INPUT_PRICE_PER_MILLION=0
QINIU_OUTPUT_PRICE_PER_MILLION=0
# 商机抽取默认关闭深度思考并强制 JSON 模式，减少延迟和无效 reasoning token。
QINIU_ENABLE_THINKING=false
QINIU_JSON_MODE=true
# 当前真实验收出现过 RPM=rate_limit_rpm_exceeded。默认 6.5 秒统一发一个请求，约 9.2 RPM；
# 429 时优先遵循 Retry-After，否则按 15/30/60/60 秒指数退避，最多重试 4 次。
QINIU_MIN_REQUEST_INTERVAL_SECONDS=6.5
QINIU_RATE_LIMIT_RETRIES=4
QINIU_RATE_LIMIT_BACKOFF_SECONDS=15
# 正常 Agent 仍按 AGENT_MAX_NEW_TOKENS=800；只有明确发生 JSON 截断时才自动重试一次，最多 1600 tokens。
QINIU_JSON_RETRY_MAX_TOKENS=1600

# 真实商品文件生成目录。生成后的 ZIP 会登记为 self_owned SourceAsset，再进入 Gate B。
ARTIFACT_DIR=/app/data/generated
DEFAULT_PRODUCT_CURRENCY=CNY

# Etsy Open API v3 真上架。未完整配置时系统会明确阻断 publish，不会伪造成功。
# OAuth token 需要 listings_w scope。
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=
ETSY_SHOP_ID=
ETSY_TAXONOMY_ID=0
ETSY_SHOP_CURRENCY=
ETSY_LISTING_QUANTITY=999
ETSY_WHO_MADE=i_did
ETSY_WHEN_MADE=made_to_order


# 闲鱼真实采集/上架：复用 Chrome 登录 goofish.com + OpenCLI Browser Bridge。
# 主机 bridge 如要允许真正上架，必须额外设置 AGENT_REACH_BRIDGE_ALLOW_WRITES=true。
XIANYU_PUBLISH_CATEGORY=
XIANYU_PUBLISH_CONDITION=全新
XIANYU_SHOP_CURRENCY=CNY

# 闲鱼官方合作方订单/虚拟发货 TOP 能力。
# 官方要求定向邀请、API 权限以及聚石塔部署；未满足时保持空，不伪造自动发货。
XIANYU_TOP_APP_KEY=
XIANYU_TOP_APP_SECRET=
XIANYU_TOP_ACCESS_TOKEN=
XIANYU_TOP_BIZ_CODE=
# 官方订单返回的 encryption_seller_id；发货必须与此稳定卖家标识一致，不能使用昵称。
XIANYU_TOP_SELLER_ID=
XIANYU_TOP_GATEWAY=https://gw.api.taobao.com/router/rest
